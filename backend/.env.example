NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/mwasalat

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Absolute origin of the deployed frontend, no trailing slash, e.g.
# https://eonix-academy.vercel.app — used for CORS and also interpolated
# directly into email/certificate/Stripe redirect links throughout the app,
# so it must be a single URL (not a list).
CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=academy@eonixsolutions.in
SMTP_PASS=your_app_password
SMTP_FROM=Eonix Solutions <academy@eonixsolutions.in>

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Server-to-Server OAuth app from the Zoom Marketplace (meeting:write:meeting scope).
# Used to auto-create Zoom meetings for live/ILT classes. Optional — if unset,
# instructors can still paste a meeting link in manually.
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Web Push (browser push notifications) VAPID key pair. Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Public key is not secret — mirror it into frontend/.env as
# VITE_MWASALAT_VAPID_PUBLIC_KEY. Optional — if unset, push sending is a no-op.
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:academy@eonixsolutions.in

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@eonixsolutions.in
SUPER_ADMIN_PASSWORD=ChangeMe@1234
