# Absolute origin of the deployed backend API, no trailing slash, e.g.
# https://eonix-academy-api.onrender.com. Leave unset in local dev — relative
# paths go through the Vite dev proxy in vite.config.js instead.
VITE_MWASALAT_API_URL=

# Same origin as VITE_MWASALAT_API_URL above, used for the socket.io
# connection. Leave unset in local dev (falls back to window.location.origin,
# which the Vite proxy forwards to the local backend).
VITE_SOCKET_URL=

VITE_MWASALAT_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Optional — hides "supervisor" from admin-facing role pickers (Invite Staff dropdown,
# staff role filter, announcement audience targeting) for demos. Leave unset/false to
# keep it visible; backend RBAC and existing supervisor accounts are unaffected either way.
VITE_MWASALAT_HIDE_SUPERVISOR_ROLE=false
# Optional — Google Analytics 4 Measurement ID. Leave unset to disable analytics entirely.
VITE_MWASALAT_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Must match backend's VAPID_PUBLIC_KEY (see backend/.env.example). Optional —
# leave unset to disable the "enable push notifications" prompt entirely.
VITE_MWASALAT_VAPID_PUBLIC_KEY=your_vapid_public_key
